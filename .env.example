# -----------------------------------------------------------------------------
# SCENTLOG environment variables
# Copy this file to `.env.local` and fill in the values. Never commit .env.local.
# -----------------------------------------------------------------------------

# Supabase project URL.
# Supabase dashboard → Project Settings → API → Project URL
# Local development (npx supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Supabase PUBLISHABLE key (starts with sb_publishable_). Safe for the browser:
# Row Level Security decides what each user can do.
# Supabase dashboard → Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the site (used for auth redirects and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: the Supabase SECRET key (sb_secret_...) must NEVER be added with a
# NEXT_PUBLIC_ prefix and is not needed by the app at this stage.

# --- Legal pages (shown in /privacy, /terms, /cookies) -----------------------
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION=
